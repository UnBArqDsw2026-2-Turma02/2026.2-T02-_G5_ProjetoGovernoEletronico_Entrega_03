@startuml GoF_Criacional_FactoryMethod_V01
' =============================================================
' Projeto Informa.BR | Grupo 05 | FGA0208
' Padroes de Projeto GoF — Criacional: FACTORY METHOD
' Aplicado a hierarquia Resposta do Diagrama de Classes (Entrega 02)
' Versao 1.0 (revisada) — SubEquipe 03
' Revisao: nomes sem acento/espaço; composicao PedidoAcesso-Resposta;
' DadosResposta e StatusManifestacao modelados; rotulos ajustados.
' =============================================================

title GoF Criacional — Factory Method aplicado à emissão de Respostas LAI | Informa.BR | G5 | SubEquipe 03 | v1.0

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam nodesep 45
skinparam ranksep 55
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #2C3E50
skinparam classFontStyle bold
skinparam arrowColor #2C3E50
skinparam noteBackgroundColor #FEF9E7
skinparam noteBorderColor #D4AC0D
skinparam packageBorderColor #7F8C8D
skinparam packageFontColor #34495E
hide circle
hide empty members

' ==========================================================
' CLIENTE
' ==========================================================
package "Cliente" {
  class AgentePublico {
    - matricula : String
    - cargo : String
    + elaborarResposta(p : PedidoAcesso, f : FabricaResposta, d : DadosResposta) : Resposta
  }

  class PedidoAcesso {
    - protocolo : String
    - status : StatusManifestacao
    + vincularResposta(r : Resposta) : void
  }
}

' ==========================================================
' CREATOR + CONCRETE CREATORS
' ==========================================================
package "Criadores (Creator)" {
  abstract class FabricaResposta <<Creator>> {
    + emitirResposta(p : PedidoAcesso, a : AgentePublico, d : DadosResposta) : Resposta
    # {abstract} criarResposta(d : DadosResposta, a : AgentePublico) : Resposta
  }

  class FabricaRespostaDeferida <<ConcreteCreator>> {
    # criarResposta(d : DadosResposta, a : AgentePublico) : Resposta
  }
  class FabricaRespostaParcial <<ConcreteCreator>> {
    # criarResposta(d : DadosResposta, a : AgentePublico) : Resposta
  }
  class FabricaRespostaIndeferida <<ConcreteCreator>> {
    # criarResposta(d : DadosResposta, a : AgentePublico) : Resposta
  }
}

' ==========================================================
' PRODUCT + CONCRETE PRODUCTS (mesma hierarquia da Entrega 02)
' ==========================================================
package "Produtos (Product)" {
  abstract class Resposta <<Product>> {
    - dataResposta : Date
    - texto : String
    - agenteResponsavel : String
    + publicar() : void
    + {abstract} cabeRecurso() : Boolean
    + {abstract} tipo : String
  }

  class RespostaDeferida <<ConcreteProduct>> {
    - linkAcesso : String
    - formatoArquivo : String
    + disponibilizarDados() : void
  }

  class RespostaParcialmenteDeferida <<ConcreteProduct>> {
    - partesOcultadas : String
    - justificativaRestricao : String
    - enquadramentoLGPD : String
    + indicarPrazoRecursal() : String
  }

  class RespostaIndeferida <<ConcreteProduct>> {
    - motivoNegativa : String
    - dispositivoLegalLAI : String
    + indicarAutoridadeRecursal() : String
  }
}

' ==========================================================
' APOIO: DADOS E STATUS
' ==========================================================
package "Apoio" {
  class DadosResposta {
    - texto : String
    - linkAcesso : String
    - formatoArquivo : String
    - partesOcultadas : String
    - justificativaRestricao : String
    - enquadramentoLGPD : String
    - motivoNegativa : String
    - dispositivoLegalLAI : String
    - autoridadeRecursal : String
  }

  class StatusManifestacao <<enumeration>> {
    EM_ELABORACAO
    PROTOCOLADO
    EM_ANALISE
    AGUARDANDO_COMPLEMENTACAO
    RESPONDIDO
    EM_RECURSO_1
    EM_RECURSO_2
    ENCERRADO
    CANCELADO
  }
}

' ==========================================================
' RELACIONAMENTOS
' ==========================================================
FabricaResposta <|-- FabricaRespostaDeferida
FabricaResposta <|-- FabricaRespostaParcial
FabricaResposta <|-- FabricaRespostaIndeferida

Resposta <|-- RespostaDeferida
Resposta <|-- RespostaParcialmenteDeferida
Resposta <|-- RespostaIndeferida

FabricaRespostaDeferida ..> RespostaDeferida : <<create>>
FabricaRespostaParcial ..> RespostaParcialmenteDeferida : <<create>>
FabricaRespostaIndeferida ..> RespostaIndeferida : <<create>>

FabricaResposta ..> Resposta : produz
FabricaResposta ..> DadosResposta : utiliza
AgentePublico --> FabricaResposta : usa
AgentePublico ..> PedidoAcesso : responde
PedidoAcesso "1" *-- "0..1" Resposta : origina
PedidoAcesso "1" --> "1" StatusManifestacao : possui

' ==========================================================
' NOTAS
' ==========================================================
note right of FabricaResposta
  <b>Template do processo de emissão</b>
  emitirResposta(p, a, d):
    r = criarResposta(d, a)   // factory method
    p.vincularResposta(r)
    r.publicar()
    return r
end note

note bottom of FabricaRespostaParcial
  Valida as regras de privacidade
  antes de instanciar o produto:
  partes ocultadas + base legal
  (LAI art. 7º §2º e art. 31; LGPD).
end note

note bottom of FabricaRespostaIndeferida
  Exige o dispositivo legal da
  negativa (LAI art. 11 §1º, II)
  e informa o prazo recursal
  de 10 dias (LAI art. 15).
end note

@enduml
